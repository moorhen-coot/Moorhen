{
    "$schema": "https://typedoc.org/schema.json",
    "name": "Moorhen API Reference",
    "entryPoints": [
        "src/moorhen.ts",
        "src/WebComponent/entry.ts",
        "src/WebComponent/utils/entry.ts"
    ],
    "entryPointStrategy": "resolve",
    "tsconfig": "./tsconfig.json",
    "out": "docs/api",
    "readme": "none",
    "includeVersion": true,
    "excludePrivate": true,
    "excludeInternal": true,
    "excludeExternals": true,
    "skipErrorChecking": true,
    "categorizeByGroup": true,
    "groupOrder": ["Classes", "Interfaces", "Type Aliases", "Variables", "Functions", "*"],
    "navigation": {
        "includeCategories": true,
        "includeGroups": true
    },
    "searchInComments": true,
    "intentionallyNotExported": [
        "ColourRuleSelectionType",
        "DisplayBuffer",
        "HoveredAtom",
        "INTERNAL_REPRESENTATION_STYLES",
        "MTZColumnHeader",
        "MoorhenMapSelectBaseProps",
        "MoorhenMoleculeSelectType",
        "MoorhenSliderDefault",
        "MoorhenSliderRange",
        "MoorhenVector",
        "Overlay2DFracPath",
        "Overlay2DImageSrcFrac",
        "Overlay2DLatexSrcFrac",
        "Overlay2DSessionData",
        "Overlay2DSvgPath",
        "Overlay2DTextFrac",
        "PREFERENCES_MAP",
        "PayloadMap",
        "RepresentationRuleType",
        "ResidueSelection",
        "ResidueSelectionRuleType",
        "Snackbar",
        "SnackbarPayload",
        "mapDataSession",
        "moleculeSessionData",
        "viewDataSession",
        "gemmi.Structure",
        "gemmi.cifDocument",
        "libcootApi.HistogramInfoJS",
        "libcootApi.InstancedMeshJS",
        "libcootApi.PairType",
        "libcootApi.ResidueSpecJS",
        "libcootApi.SimpleMeshJS",
        "libcootApi.headerInfoJS",
        "libcootApi.mapCellJS",
        "moorhen.AceDRGInstance",
        "moorhen.AtomInfo",
        "moorhen.ColourRuleObject",
        "moorhen.DisplayObject",
        "moorhen.WorkerResponse",
        "moorhen.coorFormats",
        "moorhen.cootBondOptions",
        "moorhen.lskqbResidueRangeMatch",
        "moorhen.selectedMtzColumns",
        "privateer.ResultsEntry",
        "webGL.MGWebGL",
        "SeqElement"
    ],
    "logLevel": "Warn",
    "treatWarningsAsErrors": false
}
