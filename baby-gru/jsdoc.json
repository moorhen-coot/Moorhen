{
    "tags": {
      "allowUnknownTags": true,
      "dictionaries": ["jsdoc", "closure"]
    },
    "source": {
      "include": ["./src/"],
      "excludePattern": "(src/__tests__/|src/WebGLgComponents/|src/utils/__graphql__/|src/types|src/protobuf|src/LhasaReact/bundler_plugins/vite.mjs)",
      "includePattern": ".(jsx|js|ts|tsx)$"
    },
    "plugins": ["plugins/markdown", "node_modules/jsdoc-babel"],
    "typescript": {
        "moduleRoot": "./src"
    },
    "templates": {
        "search": true,
        "default": {
            "staticFiles": {
                "include": [
                    "./documentation/docs.styles.css",
                    "./documentation/theme-toggle.js",
                    "./public/MoorhenAssets/pixmaps/MoorhenLogo.png"
                ]
            }
        },
        "cleverLinks": false,
        "monospaceLinks": false
    },
    "babel": {
        "extensions": ["tsx","ts"],
        "ignore": ["**/*.(test|spec).ts"],
        "babelrc": false,
        "presets": [["@babel/preset-env", { "targets": { "node": true } }], "@babel/preset-typescript"],
        "plugins": ["@babel/proposal-class-properties", "@babel/proposal-object-rest-spread"]
    },
    "opts": {
        "encoding": "utf8",
        "destination": "./docs/api/",
        "recurse": true,
        "verbose": true,
        "private": true,
        "template": "node_modules/docdash"
    },
    "docdash": {
        "meta": {
            "title": "Moorhen API Reference",
            "description": "Moorhen API Reference",
            "keyword": "Moorhen API Reference"
        },
        "collapse":true,
        "sectionOrder": [
             "Classes",
             "Modules",
             "Global",
             "Externals",
             "Events",
             "Namespaces",
             "Mixins",
             "Interfaces"
        ],
        "scripts": ["docs.styles.css", "theme-toggle.js"],
        "menu":{
            "Docs Home": {
                "href":"../index.html",
                "class":"menu-item",
                "id":"docs-home"
            },
            "Toggle Theme": {
                "href":"#",
                "class":"menu-item",
                "id":"theme-toggle"
            },
            "GitHub": {
                "href":"https://github.com/moorhen-coot/Moorhen",
                "target":"_blank",
                "class":"menu-item",
                "id":"repository"
            },
            "Moorhen Wiki": {
                "href":"https://moorhen-coot.github.io/wiki/",
                "target":"_blank",
                "class":"menu-item",
                "id":"repository"
            }
        },
        "search": true
    }
}
